# @name    Bilibili Live
# @desc    Bilibili Streaming Status & Follower Count
# @author  Tony Chang (github.com/tony-aptx4869)
# @version 2.0
# @icons   bilibiliblink, bilibililive
# @config fllwmode bool "Follower Mode" default=false help="Only show Follower Count using UID below"
# @config uid text "UID" default="9617619" help="The number in space.bilibili.com/<uid>"
# @config roomid text "Room ID" default="6" help="The number in live.bilibili.com/<roomid>"
# @config nicon text "Normal Icon" default="bilibiliblink" help="Custom Normal Icon"
# @config sicon text "Streaming Icon" default="bilibililive" help="Custom Streaming Icon"
# @config showfllw bool "Show Follower Count" default=true help="Show Follower Count after Viewers Online in Living Status"
# @config every number "Refresh" default=1 min=1 max=1440 unit=min
# @config duration number "Duration" default=10 min=0 max=3600 unit=s help="Set 0 = System Time per app"

import gc

class BilibiliLive
  var period, nicon, sicon, ic, label, tint, live, showing
  var live_label, fans_label, ticks, fails, in_flight, timeout, flip_timer
  var show_start, flipped, total, live_ms, showfllw, fllwmode, uid

  def init()
    self.period = store.get("every") * 60
    self.nicon = store.get("nicon")
    self.sicon = store.get("sicon")
    self.ic = self.nicon
    self.label = "..."
    self.tint = settings.get("textColor")
    if self.tint == nil self.tint = 0xFFFFFF end
    var secs = store.get("duration")
    if secs == 0
      self.total = settings.get("appDurationMs")
    else
      self.total = int(secs * 1000)
    end
    if self.total == nil self.total = 7000 end
    self.live_ms = int(self.total * 0.7)
    self.showfllw = store.get("showfllw")
    if self.showfllw == nil self.showfllw = true end
    self.fllwmode = store.get("fllwmode")
    self.uid = store.get("uid")
    self.live = false
    self.showing = false
    self.live_label = "..."
    self.fans_label = "..."
    self.ticks = 0
    self.fails = 0
    self.in_flight = false
    self.timeout = false
    self.flip_timer = nil
    self.show_start = 0
    self.flipped = false
  end

  def fmt(v)
    if v >= 1000000000000 return str(int(v / 1000000000000.0 + 0.5)) + "T" end
    if v >= 1000000000 return str(int(v / 1000000000.0 + 0.5)) + "G" end
    if v >= 1000000 return str(int(v / 1000000.0 + 0.5)) + "M" end
    if v >= 1000 return str(int(v / 1000.0 + 0.5)) + "K" end
    return str(int(v))
  end

  def fetch()
    if self.in_flight || self.timeout return end
    var url = ""
    if self.fllwmode
      var uid = self.uid
      if uid == nil || uid == "" return end
      url = "https://api.bilibili.com/x/relation/stat?vmid=" + uid
    else
      var room = store.get("roomid")
      if room == nil || room == "" return end
      url = "https://api.live.bilibili.com/room/v1/Room/get_info?room_id=" + room
    end
    self.in_flight = true
    gc.collect()
    http.get(url, / b, st -> self.on_body(b, st))
  end

  def on_body(body, status)
    self.in_flight = false
    var ok = false
    if body != nil
      var c = re.search("\"code\":(\\d+)", body)
      if c != nil && num(c[1]) == 0
        if self.fllwmode
          var f = re.search("\"follower\":(\\d+)", body)
          if f != nil
            var fans = num(f[1])
            if fans != nil
              self.live = false
              self.flipped = false
              self.fans_label = self.fmt(fans)
              self.ic = self.nicon
              self.label = self.fans_label
              ok = true
            end
          end
        else
          var a = re.search("\"attention\":(\\d+)", body)
          var o = re.search("\"online\":(\\d+)", body)
          var l = re.search("\"live_status\":(\\d+)", body)
          if a != nil && o != nil && l != nil
            var fans = num(a[1])
            var online = num(o[1])
            var live = num(l[1])
            if fans != nil && online != nil && live != nil
              self.live = live == 1
              self.live_label = self.fmt(online)
              self.fans_label = self.fmt(fans)
              if !self.showing self.flipped = false end
              self.ic = (self.flipped || !self.live) ? self.nicon : self.sicon
              self.label = (self.flipped || !self.live) ? self.fans_label : self.live_label
              if self.showing && self.live && self.showfllw && !self.flipped && self.flip_timer == nil
                var left = self.live_ms - (now_ms() - self.show_start)
                if left < 500 left = 500 end
                self.flip_timer = timer.after(left, / -> self.flip(true))
              end
              ok = true
            end
          end
        end
      end
    end
    if ok
      self.fails = 0
      self.timeout = false
      var t = settings.get("textColor")
      if t == nil t = 0xFFFFFF end
      self.tint = t
    else
      self.fails += 1
      if self.fails >= 3
        self.timeout = true
        self.label = "Check ID"
        self.tint = 0xFFA500
      else
        timer.after(5000, / -> self.fetch())
      end
    end
  end

  def loop()
    if !self.timeout
      var c = settings.get("textColor")
      if c != nil self.tint = c end
    end
    if self.ticks <= 0
      self.ticks = self.period
      self.fetch()
    end
    self.ticks -= 1
  end

  def flip(to_fans)
    self.flip_timer = nil
    self.flipped = to_fans
    self.ic = to_fans ? self.nicon : self.sicon
    self.label = to_fans ? self.fans_label : self.live_label
    if self.showing && self.live && self.showfllw
      var d = to_fans ? (self.total - self.live_ms) : self.live_ms
      self.flip_timer = timer.after(d, / -> self.flip(!to_fans))
    end
  end

  def on_show()
    self.showing = true
    self.show_start = now_ms()
    self.flipped = false
    if self.flip_timer != nil
      timer.cancel(self.flip_timer)
      self.flip_timer = nil
    end
    self.ic = self.live ? self.sicon : self.nicon
    self.label = self.live ? self.live_label : self.fans_label
    if self.live && self.showfllw
      self.flip_timer = timer.after(self.live_ms, / -> self.flip(true))
    end
  end

  def on_hide()
    self.showing = false
    if self.flip_timer != nil
      timer.cancel(self.flip_timer)
      self.flip_timer = nil
    end
  end

  def duration()
    return self.total
  end

  def draw()
    clear()
    if !icon(self.ic, 0, 0) rect_fill(1, 1, 6, 6, 0x222222) end
    scroll_text(9, 6, width() - 9, self.label, self.tint)
  end
end

return BilibiliLive()
